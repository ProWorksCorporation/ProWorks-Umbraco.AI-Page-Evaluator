<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ProWorks.Umbraco.AI.PageEvaluator</RootNamespace>
    <AssemblyName>ProWorks.Umbraco.AI.PageEvaluator.Core</AssemblyName>
    <Description>Domain interfaces and models for the ProWorks Umbraco AI Page Evaluator package.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Umbraco interfaces (IContentTypeService, etc.) -->
    <!-- Verify version against target Umbraco installation before building -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.8.0, 18.0.0)" />
    <!-- IAIVersionableEntity and the AIEntitySaved/DeletedNotification bases (006 research R10).
         Same range as the RCL, which already depends on it. -->
    <PackageReference Include="Umbraco.AI.Core" Version="[17.6.1, 18.0.0)" />
  </ItemGroup>

</Project>
