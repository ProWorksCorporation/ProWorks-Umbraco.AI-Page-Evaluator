<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Latest mutually compatible Umbraco.AI set for CMS 17.8 (005 FR-005): Agent 17.4.1 needs
         Umbraco.AI.Startup >= 17.6.1, and the Umbraco.AI 17.6.1 meta-package pins Startup to exactly [17.6.1]. -->
    <PackageReference Include="Umbraco.AI.Agent" Version="17.4.1" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot" Version="17.2.0" />
    <PackageReference Include="Umbraco.AI.Anthropic" Version="17.1.3" />
    <PackageReference Include="Umbraco.AI.OpenAI" Version="17.3.1" />
    <PackageReference Include="Umbraco.AI.Prompt" Version="17.4.0" />
    <PackageReference Include="Umbraco.AI.Startup" Version="17.6.1" />
    <PackageReference Include="Umbraco.Cms" Version="17.8.0" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.8.0" />
    <PackageReference Include="Umbraco.AI" Version="17.6.1" />
    <PackageReference Include="uSync" Version="17.5.2" />
    <!-- 006 (owner decision D7): Umbraco Automate for the "Evaluate Page" step. 17.5.1 is the add-on's floor
         (older versions continue a run after a failed step); it supports CMS [17.6.0, 18). -->
    <PackageReference Include="Umbraco.Automate" Version="17.5.1" />
    <!-- AI steps for Automate ("Run AI Agent" etc.; used for QS-B7). 17.1.0, not 17.2.0: 17.2.0 needs
         Umbraco.AI.Agent >= 17.4.2, which needs Umbraco.AI 17.7.0 and would lift the TestSite off the 17.6.1 floor. -->
    <PackageReference Include="Umbraco.AI.Automate" Version="17.1.0" />
    <!-- Pin Microsoft.Extensions.AI packages to 10.7.0, required by Umbraco.AI.Core 17.6.1
         (range [10.7.0, 11)) and Anthropic 12.29.1. All three packages must be the same version. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProWorks.Umbraco.AI.PageEvaluator\ProWorks.Umbraco.AI.PageEvaluator.csproj" />
    <ProjectReference Include="..\ProWorks.Umbraco.AI.PageEvaluator.Automate\ProWorks.Umbraco.AI.PageEvaluator.Automate.csproj" />
    <!-- Both migration assemblies must be present to match what the NuGet package bundles in lib/net10.0/ -->
    <ProjectReference Include="..\ProWorks.Umbraco.AI.PageEvaluator.Persistence.Sqlite\ProWorks.Umbraco.AI.PageEvaluator.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\ProWorks.Umbraco.AI.PageEvaluator.Persistence.SqlServer\ProWorks.Umbraco.AI.PageEvaluator.Persistence.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required by dotnet-ef when this project is used as the startup project for migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <UserSecretsId>7af40d60-d979-40b2-9022-fa72e256d134</UserSecretsId>
  </PropertyGroup>

</Project>
