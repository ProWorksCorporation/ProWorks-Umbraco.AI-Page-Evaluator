<?xml version="1.0" encoding="utf-8"?>
<DataType Key="92edc42f-ecba-40a3-9e7e-56cd0cdbc378" Alias="Test Block - Summary - Rich Text Editor" Level="1">
  <Info>
    <Name>Test Block - Summary - Rich Text Editor</Name>
    <EditorAlias>Umbraco.RichText</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.Tiptap</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "extensions": [
    "Umb.Tiptap.RichTextEssentials",
    "Umb.Tiptap.Anchor",
    "Umb.Tiptap.Blockquote",
    "Umb.Tiptap.Bold",
