      ],
      [
        "Umb.Tiptap.Toolbar.BulletList",
        "Umb.Tiptap.Toolbar.OrderedList"
      ],
      [
        "Umb.Tiptap.Toolbar.Blockquote",
        "Umb.Tiptap.Toolbar.HorizontalRule",
        "Umb.Tiptap.Toolbar.Table",
        "Umb.Tiptap.Toolbar.CodeBlock",
        "Umb.Tiptap.Toolbar.Table"
