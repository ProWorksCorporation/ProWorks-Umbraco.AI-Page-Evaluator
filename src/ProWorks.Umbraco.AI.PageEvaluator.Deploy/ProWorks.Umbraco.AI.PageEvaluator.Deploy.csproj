<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ProWorks.Umbraco.AI.PageEvaluator.Deploy</RootNamespace>
    <AssemblyName>ProWorks.Umbraco.AI.PageEvaluator.Deploy</AssemblyName>
    <Description>Umbraco Deploy support for ProWorks AI Page Evaluator configurations: deploys evaluator configurations between environments with their AI profile and context dependencies.</Description>
    <!-- NuGet packaging: same version line as the main package (FR-042) -->
    <PackageId>ProWorks.Umbraco.AI.PageEvaluator.Deploy</PackageId>
    <Version>17.6.1</Version>
    <Authors>ProWorks, Jason Prothero</Authors>
    <Company>ProWorks Corporation</Company>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;umbraco-ai;ai;page-evaluator;deploy</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) $([System.DateTime]::UtcNow.ToString(`yyyy`)) ProWorks Corporation</Copyright>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ProWorksCorporation/ProWorks-Umbraco.AI-Page-Evaluator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProWorksCorporation/ProWorks-Umbraco.AI-Page-Evaluator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>17.6.1: First release. Adds Umbraco Deploy support (Umbraco.AI.Deploy 17.3.1+) for evaluator configurations: they move between environments with their AI profile and context, adopt matching hand-made configurations on the first deploy, apply the source's active state, clear affected cached evaluations, and are removed by Deploy's schema clean-up when deleted at the source.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The refresher handlers are internal (as in Umbraco.AI.Prompt.Deploy); the tests check their bindings. -->
    <InternalsVisibleTo Include="ProWorks.Umbraco.AI.PageEvaluator.Deploy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The main package. Packs as a dependency on ProWorks.Umbraco.AI.PageEvaluator; the range is
         capped below 18.0.0 by the SetMainPackageVersionRange target (research R11). -->
    <ProjectReference Include="..\ProWorks.Umbraco.AI.PageEvaluator\ProWorks.Umbraco.AI.PageEvaluator.csproj" />
    <!-- Core.dll ships inside the main package's lib/, so it is a compile reference only. -->
    <ProjectReference Include="..\ProWorks.Umbraco.AI.PageEvaluator.Core\ProWorks.Umbraco.AI.PageEvaluator.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Umbraco.AI.Deploy 17.3.1 is the release compatible with Umbraco.AI 17.6.1 (constitution 1.5.0). -->
    <PackageReference Include="Umbraco.AI.Deploy" Version="[17.3.1, 18.0.0)" />
  </ItemGroup>

  <!-- A ProjectReference packs as ">= 17.6.1" with no upper bound; cap it at the next major
       (constitution 1.5.0: add-ons depend on the main package [17.6.1, 18.0.0)). -->
  <Target Name="SetMainPackageVersionRange" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      Condition="'%(Filename)' == 'ProWorks.Umbraco.AI.PageEvaluator'"
                                      ProjectVersion="[$(Version), 18.0.0)" />
    </ItemGroup>
  </Target>

</Project>
